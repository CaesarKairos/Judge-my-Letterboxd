# Copie para .dev.vars. Nunca coloque valores reais neste arquivo versionado.
TMDB_API_KEY="sua-chave-tmdb-opcional"
AI_MODEL="@cf/openai/gpt-oss-120b"
AI_FALLBACK_MODELS="@cf/openai/gpt-oss-20b"
JUDGE_MAINTENANCE_MODE="0"
# O binding Workers AI chamado AI é fornecido pelo Wrangler local ou pela configuração Pages.
# Opcional para Curated: AI_ANALYST_MODEL e AI_WRITER_MODEL.
# JUDGE_DEBUG_CONFIG=1 habilita /api/config (diagnóstico local, nunca expõe a chave).
