# Copie para .dev.vars. Nunca coloque valores reais neste arquivo versionado.
GROQ_API_KEY="sua-chave-groq"
TMDB_API_KEY="sua-chave-tmdb-opcional"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODELS="openai/gpt-oss-20b"
JUDGE_MAINTENANCE_MODE="0"
