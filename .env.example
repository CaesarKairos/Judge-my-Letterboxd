GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
JUDGE_MAINTENANCE_MODE=0
# Optional Curated pipeline overrides:
# GROQ_ANALYST_MODEL=openai/gpt-oss-120b
# GROQ_ANALYST_FALLBACK_MODELS=openai/gpt-oss-20b
# GROQ_WRITER_MODEL=openai/gpt-oss-120b
# GROQ_WRITER_FALLBACK_MODELS=openai/gpt-oss-20b

JUDGE_LANGUAGE=pt-BR
MAX_CONTEXT_CHARS=1000000
ANALYST_RAW_EXPORT=1

SCRIPT_MAX_BEATS=12
WRITER_MAX_CONTEXT_CHARS=100000
WRITER_MAX_LINES=4
WRITER_MAX_WORDS_PER_LINE=14

ANALYST_TEMPERATURE=0.2
WRITER_TEMPERATURE=0.75
WRITER_ACID_LEVEL=0.75

JUDGE_HUMOR_TEMPLATES=0
