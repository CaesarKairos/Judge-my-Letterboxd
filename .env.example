GEMINI_API_KEY=

# Legacy fallback: used only when stage-specific variables are absent.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=

# Quality-sensitive stages can use different primary/fallback chains.
GEMINI_ANALYST_MODEL=gemini-flash-latest
GEMINI_ANALYST_FALLBACK_MODELS=
GEMINI_WRITER_MODEL=gemini-flash-latest
GEMINI_WRITER_FALLBACK_MODELS=

JUDGE_LANGUAGE=pt-BR
MAX_CONTEXT_CHARS=1000000
ANALYST_RAW_EXPORT=1

SCRIPT_MAX_BEATS=12
WRITER_MAX_CONTEXT_CHARS=100000
WRITER_MAX_LINES=4
WRITER_MAX_WORDS_PER_LINE=14

ANALYST_TEMPERATURE=0.2
WRITER_TEMPERATURE=0.75
WRITER_ACID_LEVEL=0.75

MODEL_DISCOVERY=1
MODEL_DISCOVERY_CHAIN_LIMIT=8
MODEL_DISCOVERY_TTL_MINUTES=30
JUDGE_HUMOR_TEMPLATES=0
