# Legacy Python prototype only; the supported web runtime uses the Cloudflare Pages AI binding.
GEMINI_API_KEY=
TMDB_API_KEY=
AI_MODEL=@cf/openai/gpt-oss-120b
AI_FALLBACK_MODELS=@cf/openai/gpt-oss-20b
JUDGE_MAINTENANCE_MODE=0
# Optional Curated pipeline overrides:
# AI_ANALYST_MODEL=@cf/openai/gpt-oss-120b
# AI_ANALYST_FALLBACK_MODELS=@cf/openai/gpt-oss-20b
# AI_WRITER_MODEL=@cf/openai/gpt-oss-120b
# AI_WRITER_FALLBACK_MODELS=@cf/openai/gpt-oss-20b

JUDGE_LANGUAGE=pt-BR
MAX_CONTEXT_CHARS=1000000
ANALYST_RAW_EXPORT=1

SCRIPT_MAX_BEATS=12
WRITER_MAX_CONTEXT_CHARS=100000
WRITER_MAX_LINES=4
WRITER_MAX_WORDS_PER_LINE=14

ANALYST_TEMPERATURE=0.2
WRITER_TEMPERATURE=0.75
WRITER_ACID_LEVEL=0.75

JUDGE_HUMOR_TEMPLATES=0
